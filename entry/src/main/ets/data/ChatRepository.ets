import { ConversationRecord, MessageRecord, MessageStatus } from '../model/ChatModels';
import { DatabaseManager } from './DatabaseManager';
export class ChatRepository {
  private database: DatabaseManager;
  constructor(database: DatabaseManager) { this.database = database; }
  async listConversations(): Promise<ConversationRecord[]> { const store = this.database.getRdbStore(); if (store === undefined) return []; const result = await store.querySql('SELECT * FROM conversations ORDER BY updated_at DESC'); const items: ConversationRecord[] = []; while (result.goToNextRow()) items.push({ id: result.getString(result.getColumnIndex('id')), title: result.getString(result.getColumnIndex('title')), providerId: result.getString(result.getColumnIndex('provider_id')), modelName: result.getString(result.getColumnIndex('model_name')), status: result.getString(result.getColumnIndex('status')) as MessageStatus, createdAt: result.getLong(result.getColumnIndex('created_at')), updatedAt: result.getLong(result.getColumnIndex('updated_at')) }); result.close(); return items; }
  async saveConversation(item: ConversationRecord): Promise<void> { const store = this.database.getRdbStore(); if (store !== undefined) await store.execute('INSERT OR REPLACE INTO conversations (id,title,provider_id,model_name,status,created_at,updated_at) VALUES (?,?,?,?,?,?,?)', [item.id,item.title,item.providerId,item.modelName,item.status,item.createdAt,item.updatedAt]); }
  async updateConversation(item: ConversationRecord): Promise<void> { const store = this.database.getRdbStore(); if (store !== undefined) await store.execute('UPDATE conversations SET title = ?, updated_at = ? WHERE id = ?', [item.title, item.updatedAt, item.id]); }
  async saveMessage(item: MessageRecord): Promise<void> { const store = this.database.getRdbStore(); if (store !== undefined) await store.execute('INSERT OR REPLACE INTO messages (id,conversation_id,sequence,role,content,reasoning_content,status,error_summary,created_at,updated_at) VALUES (?,?,?,?,?,?,?,?,?,?)', [item.id,item.conversationId,item.sequence,item.role,item.content,item.reasoningContent,item.status,item.errorSummary,item.createdAt,item.updatedAt]); }
  async messagesFor(id: string): Promise<MessageRecord[]> { const store = this.database.getRdbStore(); if (store === undefined) return []; const result = await store.querySql('SELECT * FROM messages WHERE conversation_id = ? ORDER BY sequence ASC', [id]); const items: MessageRecord[] = []; while (result.goToNextRow()) items.push({ id: result.getString(result.getColumnIndex('id')), conversationId: result.getString(result.getColumnIndex('conversation_id')), sequence: result.getLong(result.getColumnIndex('sequence')), role: result.getString(result.getColumnIndex('role')), content: result.getString(result.getColumnIndex('content')), reasoningContent: result.getString(result.getColumnIndex('reasoning_content')), status: result.getString(result.getColumnIndex('status')) as MessageStatus, errorSummary: result.getString(result.getColumnIndex('error_summary')), createdAt: result.getLong(result.getColumnIndex('created_at')), updatedAt: result.getLong(result.getColumnIndex('updated_at')) }); result.close(); return items; }
  async removeConversation(id: string): Promise<void> { const store = this.database.getRdbStore(); if (store === undefined) return; store.beginTransaction(); try { await store.execute('DELETE FROM messages WHERE conversation_id = ?', [id]); await store.execute('DELETE FROM conversations WHERE id = ?', [id]); store.commit(); } catch (_) { store.rollBack(); throw new Error('Conversation deletion failed.'); } }
}
