import { ImportPreview as PreviewModel, ProviderKind, ProtocolStyle } from '../model/ProviderModels';
import { THEME_TOKENS } from '../common/ThemeTokens';
@Component export struct ImportPreview { @Prop preview: PreviewModel = { draft: { displayName: '', providerKind: 'openaiCompatible' as ProviderKind, protocolStyle: 'openaiStyle' as ProtocolStyle, endpoint: '', modelName: '', credential: '' }, protocolStyle: 'openaiStyle' as ProtocolStyle, maskedCredential: '', errors: [] }; onConfirm: () => void = (): void => {}; onCancel: () => void = (): void => {}; onClear: () => void = (): void => {}; build() { Column({ space: 8 }) { Text('导入预览').fontWeight(FontWeight.Bold); Text(`名称：${this.preview.draft.displayName}`); Text(`模型：${this.preview.draft.modelName}`); Text(`地址：${this.preview.draft.endpoint}`); Text(`密钥：${this.preview.maskedCredential}`); ForEach(this.preview.errors, (error: string) => { Text(error).fontColor(THEME_TOKENS.danger) }); Row({ space: 8 }) { Button('清空预览').onClick(this.onClear).clickEffect({ level: ClickEffectLevel.MIDDLE, scale: 0.88 }); Button('取消导入').onClick(this.onCancel).clickEffect({ level: ClickEffectLevel.MIDDLE, scale: 0.88 }); Button('确认导入').enabled(this.preview.errors.length === 0).onClick(this.onConfirm).clickEffect({ level: ClickEffectLevel.MIDDLE, scale: 0.88 }) } }.padding(20) } }
