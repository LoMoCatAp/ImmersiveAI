import { ImportPreview as PreviewModel, ProviderKind, ProtocolStyle } from '../model/ProviderModels';
import { THEME_TOKENS } from '../common/ThemeTokens';
import { uiMaterial } from '@kit.ArkUI';
@Component export struct ImportPreview { @Prop preview: PreviewModel = { draft: { displayName: '', providerKind: 'openaiCompatible' as ProviderKind, protocolStyle: 'openaiStyle' as ProtocolStyle, endpoint: '', modelName: '', credential: '' }, protocolStyle: 'openaiStyle' as ProtocolStyle, maskedCredential: '', errors: [] }; @StorageLink('appearance_accent_color') private appearanceAccentColor: string = '#3559D8'; onConfirm: () => void = (): void => {}; onCancel: () => void = (): void => {}; onClear: () => void = (): void => {}; private immersiveMaterial(): uiMaterial.ImmersiveMaterial { return new uiMaterial.ImmersiveMaterial({ style: uiMaterial.ImmersiveStyle.THIN, materialColor: Color.Transparent, applyShadow: false, interactive: true, lightEffect: { color: this.appearanceAccentColor } }); } build() { Column({ space: 8 }) { Text('导入预览').fontWeight(FontWeight.Bold); Text(`名称：${this.preview.draft.displayName}`); Text(`模型：${this.preview.draft.modelName.length > 0 ? this.preview.draft.modelName : '导入时自动获取'}`); Text(`地址：${this.preview.draft.endpoint}`); Text(`密钥：${this.preview.maskedCredential}`); if (this.preview.draft.modelName.length === 0) Text('未提供模型名称，确认后将尝试获取可用模型。').fontSize(13).fontColor(THEME_TOKENS.secondaryText); ForEach(this.preview.errors, (error: string) => { Text(error).fontColor(THEME_TOKENS.danger) }); Row({ space: 8 }) { Button('清空预览').onClick(this.onClear).fontColor(this.appearanceAccentColor).backgroundColor(Color.Transparent).systemMaterial(this.immersiveMaterial()).clickEffect({ level: ClickEffectLevel.MIDDLE, scale: 0.88 }); Button('取消导入').onClick(this.onCancel).fontColor(this.appearanceAccentColor).backgroundColor(Color.Transparent).systemMaterial(this.immersiveMaterial()).clickEffect({ level: ClickEffectLevel.MIDDLE, scale: 0.88 }); Button('确认导入').enabled(this.preview.errors.length === 0).onClick(this.onConfirm).fontColor(this.appearanceAccentColor).backgroundColor(Color.Transparent).systemMaterial(this.immersiveMaterial()).clickEffect({ level: ClickEffectLevel.MIDDLE, scale: 0.88 }) } }.padding({ top: 12, bottom: 12, left: 12, right: 12 }).backgroundColor(Color.Transparent).borderRadius(18).systemMaterial(this.immersiveMaterial()) } }
