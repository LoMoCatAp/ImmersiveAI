import { ConversationRecord } from '../model/ChatModels';
import { ChatRepository } from '../data/ChatRepository';
import { MessageStatus } from '../model/ChatModels';
export class HistoryViewModel { conversations: ConversationRecord[] = []; selectedId: string = ''; errorMessage: string = ''; feedbackMessage: string = ''; operationBusy: boolean = false; private repository: ChatRepository; constructor(repository: ChatRepository) { this.repository = repository; } async load(): Promise<void> { try { this.conversations = await this.repository.listConversations(); this.errorMessage = ''; } catch (_) { this.errorMessage = '历史记录读取失败，请稍后重试。'; } } async tokenUsageByDay(fromDay: number): Promise<Map<number, number>> { return this.repository.tokenUsageByDay(fromDay); } select(id: string): void { this.selectedId = id; this.feedbackMessage = '已打开会话'; } async create(providerId: string, modelName: string): Promise<string> { if (this.operationBusy) { this.feedbackMessage = '上一个操作仍在进行，请稍候'; return ''; } this.operationBusy = true; this.feedbackMessage = '正在新建会话'; const now: number = Date.now(); const id: string = `${now}`; const item: ConversationRecord = { id, title: '新会话', providerId, modelName, status: MessageStatus.Completed, createdAt: now, updatedAt: now }; try { await this.repository.saveConversation(item); this.selectedId = id; await this.load(); this.feedbackMessage = '已新建并打开会话'; } catch (_) { this.errorMessage = '新建会话失败，请稍后重试'; } this.operationBusy = false; return id; } async rename(item: ConversationRecord, title: string): Promise<void> { if (this.operationBusy) return; if (title.trim().length === 0) { this.errorMessage = '请输入会话名称'; return; } this.operationBusy = true; const next: ConversationRecord = { id: item.id, title: title.trim(), providerId: item.providerId, modelName: item.modelName, status: item.status, createdAt: item.createdAt, updatedAt: Date.now() }; await this.repository.updateConversation(next); await this.load(); this.feedbackMessage = '会话名称已更新'; this.operationBusy = false; } async remove(item: ConversationRecord): Promise<void> { if (this.operationBusy) return; this.operationBusy = true; await this.repository.removeConversation(item.id); if (this.selectedId === item.id) this.selectedId = ''; await this.load(); this.feedbackMessage = '会话已删除'; this.operationBusy = false; } }
